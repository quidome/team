{
  "openapi": "3.1.0",
  "info": {
    "title": "Team",
    "description": "API of the team coordinator tool.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/changes": {
      "get": {
        "tags": [
          "changes"
        ],
        "operationId": "changes",
        "responses": {
          "200": {
            "description": "The changes not seen yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangesAnswer"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in"
          }
        }
      }
    },
    "/api/changes/seen": {
      "post": {
        "tags": [
          "changes"
        ],
        "operationId": "markSeen",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SeenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Marked; a change with another version stays",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeenAnswer"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in"
          }
        }
      }
    },
    "/api/clubs": {
      "get": {
        "tags": [
          "clubs"
        ],
        "operationId": "search",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Part of the club name. Upper or lower case is not important.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Clubs whose name contains the search, sorted by name",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClubView"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not logged in"
          },
          "502": {
            "description": "The game list cannot be reached or is not understood"
          }
        }
      }
    },
    "/api/clubs/{number}/teams": {
      "get": {
        "tags": [
          "clubs"
        ],
        "operationId": "teams",
        "parameters": [
          {
            "name": "number",
            "in": "path",
            "description": "The source's club number",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The club's own teams in the current season",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClubTeams"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in"
          },
          "404": {
            "description": "The club is not in the club list"
          },
          "502": {
            "description": "The game list cannot be reached or is not understood"
          }
        }
      }
    },
    "/api/health/liveness": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "200 while the process runs.",
        "operationId": "liveness",
        "responses": {
          "200": {
            "description": "Running"
          }
        }
      }
    },
    "/api/health/readiness": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "200 when the database answers and all migrations are applied; else 503.",
        "operationId": "readiness",
        "responses": {
          "200": {
            "description": "Ready"
          },
          "503": {
            "description": "Database not reachable or a migration is missing"
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "me"
        ],
        "operationId": "me",
        "responses": {
          "200": {
            "description": "The logged-in user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in"
          }
        }
      }
    },
    "/api/readings": {
      "post": {
        "tags": [
          "readings"
        ],
        "operationId": "read",
        "responses": {
          "200": {
            "description": "The reading; also a failed or held-back one",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingView"
                }
              }
            }
          },
          "400": {
            "description": "`no_choice`: no club is chosen"
          },
          "401": {
            "description": "Not logged in"
          }
        }
      }
    },
    "/api/readings/latest": {
      "get": {
        "tags": [
          "readings"
        ],
        "operationId": "latest",
        "responses": {
          "200": {
            "description": "The newest and the last good reading of the current club and season; `null`s with no choice",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LatestReadings"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in"
          }
        }
      }
    },
    "/api/readings/{id}/confirm-gone": {
      "post": {
        "tags": [
          "readings"
        ],
        "operationId": "confirm_gone",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The held-back reading",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A new reading: with at least as many games as the held-back reading, the missing games count as no longer in the game list; with fewer, it is held back again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingView"
                }
              }
            }
          },
          "400": {
            "description": "`not_held_back`: not the newest reading of the current club and season that did not fail, or not held back; `no_choice`"
          },
          "401": {
            "description": "Not logged in"
          },
          "404": {
            "description": "No such reading"
          }
        }
      }
    },
    "/api/schedule": {
      "get": {
        "tags": [
          "schedule"
        ],
        "operationId": "schedule",
        "responses": {
          "200": {
            "description": "The schedule to show, or `null` when there is none",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleAnswer"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in"
          }
        }
      }
    },
    "/api/selection": {
      "get": {
        "tags": [
          "selection"
        ],
        "operationId": "get",
        "responses": {
          "200": {
            "description": "The state of the choice",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Selection"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in"
          }
        }
      },
      "put": {
        "tags": [
          "selection"
        ],
        "operationId": "save",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveSelection"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Saved; the state of the choice",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Selection"
                }
              }
            }
          },
          "400": {
            "description": "`unknown_club`, `not_an_own_team` or `team_required`"
          },
          "401": {
            "description": "Not logged in"
          },
          "502": {
            "description": "The game list cannot be reached or is not understood; nothing is saved"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChangeGame": {
        "type": "object",
        "required": [
          "date",
          "home",
          "away",
          "hall",
          "town"
        ],
        "properties": {
          "away": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "description": "Dutch local date, for example \"2026-10-31\"."
          },
          "hall": {
            "type": "string"
          },
          "home": {
            "type": "string"
          },
          "start_time": {
            "type": [
              "string",
              "null"
            ],
            "description": "Dutch local start time, for example \"13:00\"; `null` when it is not known."
          },
          "town": {
            "type": "string"
          }
        }
      },
      "ChangeKindView": {
        "type": "string",
        "enum": [
          "new",
          "moved",
          "start_time_known",
          "home_and_away",
          "team_changed",
          "gone",
          "came_back",
          "into_schedule",
          "out_of_schedule"
        ]
      },
      "ChangeView": {
        "type": "object",
        "description": "A change from the game as the coordinator last saw it to the game now.",
        "required": [
          "id",
          "version",
          "kind",
          "differences",
          "reason"
        ],
        "properties": {
          "after": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ChangeGame",
                "description": "The game now; `null` for a game no longer in the game list."
              }
            ]
          },
          "before": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ChangeGame",
                "description": "The game as last seen; `null` for a new game."
              }
            ]
          },
          "differences": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DifferenceView"
            },
            "description": "Every difference of a `moved`, `start_time_known`, `home_and_away` or `team_changed`\nchange; empty for the other kinds."
          },
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "The source's game id."
          },
          "kind": {
            "$ref": "#/components/schemas/ChangeKindView"
          },
          "reason": {
            "$ref": "#/components/schemas/ScheduleReasonView",
            "description": "Now, or as last seen when the game is no longer in the schedule."
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "description": "Send it back with \"seen\": a change that a reading updated meanwhile stays."
          }
        }
      },
      "ChangesAnswer": {
        "type": "object",
        "required": [
          "changes"
        ],
        "properties": {
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChangeView"
            },
            "description": "Empty unless a team is chosen for the current season. In the order of the games."
          }
        }
      },
      "ClubTeams": {
        "type": "object",
        "required": [
          "season",
          "teams"
        ],
        "properties": {
          "season": {
            "type": "string",
            "description": "The current season, for example \"2026-2027\"."
          },
          "teams": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TeamView"
            },
            "description": "The club's own teams in the current season; empty when the season has no games yet."
          }
        }
      },
      "ClubView": {
        "type": "object",
        "required": [
          "number",
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "format": "int64",
            "description": "The source's club number."
          },
          "town": {
            "type": [
              "string",
              "null"
            ],
            "description": "`null` when the source has no town for the club."
          }
        }
      },
      "CountsView": {
        "type": "object",
        "description": "How many changes of each kind a reading found, only for games in the schedule.",
        "required": [
          "new",
          "moved",
          "start_time_known",
          "home_and_away",
          "team_changed",
          "gone",
          "came_back",
          "into_schedule",
          "out_of_schedule"
        ],
        "properties": {
          "came_back": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "gone": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "home_and_away": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "into_schedule": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "moved": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "new": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "out_of_schedule": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "start_time_known": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "team_changed": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "DifferenceView": {
        "type": "string",
        "enum": [
          "date",
          "start_time",
          "start_time_known",
          "place",
          "home_and_away",
          "team"
        ]
      },
      "ErrorKind": {
        "type": "string",
        "enum": [
          "source_unavailable",
          "source_format"
        ]
      },
      "HoldKind": {
        "type": "string",
        "enum": [
          "empty",
          "far_fewer"
        ]
      },
      "HoldView": {
        "type": "object",
        "description": "Why a reading was held back: `now` games instead of `before`.",
        "required": [
          "reason",
          "before",
          "now"
        ],
        "properties": {
          "before": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "now": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "reason": {
            "$ref": "#/components/schemas/HoldKind"
          }
        }
      },
      "LastChoice": {
        "type": "object",
        "description": "The choice of an earlier season.",
        "required": [
          "season",
          "club"
        ],
        "properties": {
          "club": {
            "$ref": "#/components/schemas/ClubView"
          },
          "season": {
            "type": "string"
          },
          "team": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TeamView"
              }
            ]
          }
        }
      },
      "LastGood": {
        "type": "object",
        "required": [
          "finished_at",
          "games_read"
        ],
        "properties": {
          "finished_at": {
            "type": "string",
            "format": "date-time"
          },
          "games_read": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "LatestReadings": {
        "type": "object",
        "description": "The newest reading and the last good reading of the current club and season.",
        "properties": {
          "held_back": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ReadingView",
                "description": "The held-back reading the coordinator can confirm: the newest reading that did not fail,\nwhen it is held back. A failed reading after it does not hide it."
              }
            ]
          },
          "last_good": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LastGood"
              }
            ]
          },
          "latest": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ReadingView"
              }
            ]
          }
        }
      },
      "Me": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "The name to show."
          }
        }
      },
      "ReadingView": {
        "type": "object",
        "description": "One reading of the game list. A failed or held-back reading is a result, not an HTTP error.",
        "required": [
          "id",
          "result",
          "finished_at",
          "first_reading"
        ],
        "properties": {
          "counts": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CountsView",
                "description": "`null` for the first reading, and for a failed or held-back reading."
              }
            ]
          },
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ErrorKind"
              }
            ]
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          },
          "first_reading": {
            "type": "boolean",
            "description": "The first reading after a choice of club or team: it counts nothing."
          },
          "games_read": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "The number of games read; `null` for a failed reading.",
            "minimum": 0
          },
          "hold": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/HoldView"
              }
            ]
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "result": {
            "$ref": "#/components/schemas/ResultKind"
          }
        }
      },
      "Reason": {
        "type": "string",
        "description": "Why a team must be chosen.",
        "enum": [
          "no_games_yet",
          "new_season"
        ]
      },
      "ResultKind": {
        "type": "string",
        "enum": [
          "good",
          "failed",
          "held_back"
        ]
      },
      "SaveSelection": {
        "type": "object",
        "required": [
          "club"
        ],
        "properties": {
          "club": {
            "type": "integer",
            "format": "int64",
            "description": "The source's club number."
          },
          "team": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "The source's team number; leave it out only when the season has no games yet."
          }
        }
      },
      "ScheduleAnswer": {
        "type": "object",
        "properties": {
          "schedule": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ScheduleView",
                "description": "`null`: no club is chosen, or a team is needed and no earlier season had one."
              }
            ]
          }
        }
      },
      "ScheduleGame": {
        "type": "object",
        "required": [
          "id",
          "date",
          "home",
          "away",
          "hall",
          "town",
          "reason",
          "in_list"
        ],
        "properties": {
          "away": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "description": "Dutch local date, for example \"2026-10-31\"."
          },
          "hall": {
            "type": "string"
          },
          "home": {
            "type": "string",
            "description": "Full team names, with the club name in front."
          },
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "The source's game id."
          },
          "in_list": {
            "type": "boolean",
            "description": "False: the game is no longer in the game list; it shows until its change is seen."
          },
          "reason": {
            "$ref": "#/components/schemas/ScheduleReasonView"
          },
          "start_time": {
            "type": [
              "string",
              "null"
            ],
            "description": "Dutch local start time, for example \"13:00\"; `null` when it is not known yet."
          },
          "town": {
            "type": "string"
          }
        }
      },
      "ScheduleReasonView": {
        "type": "string",
        "enum": [
          "team",
          "duty"
        ]
      },
      "ScheduleView": {
        "type": "object",
        "required": [
          "season",
          "last_season",
          "club",
          "team",
          "unseen_changes",
          "coming",
          "past"
        ],
        "properties": {
          "club": {
            "$ref": "#/components/schemas/ClubView"
          },
          "coming": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduleGame"
            },
            "description": "Today (Dutch date) and later, in time order."
          },
          "last_season": {
            "type": "boolean",
            "description": "True: a new season started and its team is not chosen yet; these are the games of the\nteam of the newest earlier season."
          },
          "past": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduleGame"
            },
            "description": "Before today, newest date first, in time order within a date."
          },
          "season": {
            "type": "string",
            "description": "The season of the games, for example \"2026-2027\"."
          },
          "team": {
            "$ref": "#/components/schemas/TeamView"
          },
          "unseen_changes": {
            "type": "integer",
            "format": "int32",
            "description": "The number of changes not seen yet (`GET /api/changes`); 0 for last season's schedule.",
            "minimum": 0
          }
        }
      },
      "SeenAnswer": {
        "type": "object",
        "required": [
          "open"
        ],
        "properties": {
          "open": {
            "type": "integer",
            "format": "int32",
            "description": "The number of changes not seen yet after this.",
            "minimum": 0
          }
        }
      },
      "SeenChange": {
        "type": "object",
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "SeenRequest": {
        "type": "object",
        "required": [
          "changes"
        ],
        "properties": {
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SeenChange"
            }
          }
        }
      },
      "Selection": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "season",
              "state"
            ],
            "properties": {
              "season": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": [
                  "not_chosen"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "season",
              "club",
              "reason",
              "state"
            ],
            "properties": {
              "club": {
                "$ref": "#/components/schemas/ClubView"
              },
              "last": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/LastChoice",
                    "description": "The choice of the newest earlier season, if any (for example last season's team)."
                  }
                ]
              },
              "reason": {
                "$ref": "#/components/schemas/Reason"
              },
              "season": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": [
                  "team_needed"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "season",
              "club",
              "team",
              "state"
            ],
            "properties": {
              "club": {
                "$ref": "#/components/schemas/ClubView"
              },
              "season": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": [
                  "chosen"
                ]
              },
              "team": {
                "$ref": "#/components/schemas/TeamView"
              }
            }
          }
        ],
        "description": "The state of the choice. `season` is always the current season."
      },
      "TeamView": {
        "type": "object",
        "required": [
          "number",
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "The short name, for example \"M16 1\"."
          },
          "number": {
            "type": "integer",
            "format": "int64",
            "description": "The source's team number."
          }
        }
      }
    }
  }
}
