# Local settings for `just serve` and `just dev`. Copy to .env. The names match the cluster.

# The local PostgreSQL from compose.yaml (`just db-up`). The tests create their own databases.
DATABASE_URL=postgresql://team:team@localhost:5432/team_v2

# Pocket ID (OpenID Connect). Register ${ORIGIN}/auth/callback as the callback URL.
ORIGIN=http://localhost:3000
OIDC_ISSUER_URL=https://id.example.test
OIDC_CLIENT_ID=team-coordinator
OIDC_CLIENT_SECRET=replace-with-the-pocket-id-client-secret
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Session lifetime in seconds (eight hours).
SESSION_TTL_SECONDS=28800
# Pocket ID group that may use the tool.
# TEAM_ACCESS_ROLE=team_coordinator

# The game list source (optional). Default: https://db.basketball.nl
# GAME_LIST_URL=https://db.basketball.nl

# Optional listener settings.
# HOST=0.0.0.0
# PORT=3000

# Development only: skip login. Works only in debug builds; release builds ignore it.
DEV_AUTH_BYPASS=false
