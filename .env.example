# Required for the Pocket ID OpenID Connect client and server-managed sessions.
# Register ${ORIGIN}/auth/callback as the exact callback URL in Pocket ID.
ORIGIN=https://team.example.test
OIDC_ISSUER_URL=https://pocket-id.example.test
OIDC_CLIENT_ID=team-coordinator
OIDC_CLIENT_SECRET=replace-with-the-pocket-id-client-secret
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Coordinator session lifetime in seconds. This example is eight hours.
SESSION_TTL_SECONDS=28800
